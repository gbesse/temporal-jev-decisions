{
  "name": "@gbesse/temporal-jev-decisions",
  "version": "0.1.0",
  "description": "Bounded Jev Activities and deterministic Workflow examples for Temporal.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/temporal-jev-decisions.git"
  },
  "files": [
    "src",
    "nodes",
    "app.js",
    "api.js",
    "packs",
    "examples",
    "element-templates",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "demo": "node examples/demo.mjs"
  },
  "dependencies": {
    "@gbesse/decisionpacks": "git+https://github.com/gbesse/decisionpacks.git#3c90b6e667c16653b9a6ae00b376df9bddbd8461"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@temporalio/activity": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./workflow": "./src/workflow.cjs"
  },
  "peerDependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/common": "^1.24.0"
  }
}
